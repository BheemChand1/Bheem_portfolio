<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Laravel application files outside the URL space.
    RewriteRule ^(?:app|bootstrap|config|database|docs|node_modules|resources|routes|scripts|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|vite\.config\.js)$ - [F,L,NC]

    # Let Apache serve Laravel's public directory as the site root.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
